[Unit]
Description=Tumakuru Smart Waste Management System (SWMS-2026-P1)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/tumakuru-swms
Environment="PATH=/opt/tumakuru-swms/venv/bin"
EnvironmentFile=/opt/tumakuru-swms/.env
ExecStart=/opt/tumakuru-swms/venv/bin/python run_system.py --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
