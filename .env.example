# ==============================================================================
# Smart Waste Management System (SWMS-2026-P1) - Environment Configuration
# Tumakuru City Corporation (TMP - ತುಮಕೂರು ಮಹಾನಗರ ಪಾಲಿಕೆ)
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
CORS_ORIGINS=*

# Municipal Corporation Identity
CITY_NAME=Tumakuru
CORPORATION_NAME=Tumakuru City Corporation (TMP)
STATE=Karnataka
COUNTRY=India
CITY_LAT=13.3392
CITY_LNG=77.1018

# Security & Staff Authentication
JWT_SECRET_KEY=tumakuru-smart-city-waste-management-super-secret-key-2026
SESSION_EXPIRE_HOURS=24

# Alert Engine & Thresholds
FILL_THRESHOLD=80
ALERT_DEBOUNCE_SAMPLES=5
CSV_AUDIT_LOG_PATH=alert_engine/alert_log.csv

# Cloud Sync / Firebase RTDB (Optional - leave empty for standalone local gateway)
FIREBASE_RTDB_URL=
FIREBASE_AUTH_SECRET=

# Notification Dispatchers (Optional integrations)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
DISPATCH_WEBHOOK_URL=
